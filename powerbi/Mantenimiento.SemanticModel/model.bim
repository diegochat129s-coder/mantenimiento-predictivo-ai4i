{
  "name": "MantenimientoPredictivo",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "es-MX",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "es-MX",
    "expressions": [
      {
        "name": "ServidorSQL",
        "kind": "m",
        "expression": "\"localhost\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "BaseDatosSQL",
        "kind": "m",
        "expression": "\"MantenimientoPredictivoDM\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "fact_operacion",
        "columns": [
          {
            "name": "udi",
            "dataType": "int64",
            "sourceColumn": "udi",
            "summarizeBy": "none"
          },
          {
            "name": "product_id",
            "dataType": "string",
            "sourceColumn": "product_id",
            "summarizeBy": "none"
          },
          {
            "name": "tipo_id",
            "dataType": "int64",
            "sourceColumn": "tipo_id",
            "summarizeBy": "none"
          },
          {
            "name": "estado_id",
            "dataType": "int64",
            "sourceColumn": "estado_id",
            "summarizeBy": "none"
          },
          {
            "name": "tiempo_id",
            "dataType": "int64",
            "sourceColumn": "tiempo_id",
            "summarizeBy": "none"
          },
          {
            "name": "air_temperature_k",
            "dataType": "double",
            "sourceColumn": "air_temperature_k",
            "summarizeBy": "none"
          },
          {
            "name": "process_temperature_k",
            "dataType": "double",
            "sourceColumn": "process_temperature_k",
            "summarizeBy": "none"
          },
          {
            "name": "torque_nm",
            "dataType": "double",
            "sourceColumn": "torque_nm",
            "summarizeBy": "none"
          },
          {
            "name": "rotational_speed_rpm",
            "dataType": "int64",
            "sourceColumn": "rotational_speed_rpm",
            "summarizeBy": "none"
          },
          {
            "name": "tool_wear_min",
            "dataType": "int64",
            "sourceColumn": "tool_wear_min",
            "summarizeBy": "none"
          },
          {
            "name": "twf",
            "dataType": "boolean",
            "sourceColumn": "twf",
            "summarizeBy": "none"
          },
          {
            "name": "hdf",
            "dataType": "boolean",
            "sourceColumn": "hdf",
            "summarizeBy": "none"
          },
          {
            "name": "pwf",
            "dataType": "boolean",
            "sourceColumn": "pwf",
