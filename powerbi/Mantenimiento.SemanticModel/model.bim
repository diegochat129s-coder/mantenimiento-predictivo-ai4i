          },
          {
            "name": "osf",
            "dataType": "boolean",
            "sourceColumn": "osf",
            "summarizeBy": "none"
          },
          {
            "name": "rnf",
            "dataType": "boolean",
            "sourceColumn": "rnf",
            "summarizeBy": "none"
          },
          {
            "name": "fecha_carga_utc",
            "dataType": "dateTime",
            "sourceColumn": "fecha_carga_utc",
            "summarizeBy": "none"
          },
          {
            "name": "carga_id",
            "dataType": "string",
            "sourceColumn": "carga_id",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_operacion",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatosSQL, [CreateNavigationProperties=false]),",
                "    Tabla = Origen{[Schema=\"dm\",Item=\"fact_operacion\"]}[Data]",
                "in",
                "    Tabla"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Observaciones",
            "expression": "COUNTROWS(fact_operacion)",
            "formatString": "#,0"
          },
          {
            "name": "Fallas",
            "expression": "SUM(fact_operacion[estado_id])",
            "formatString": "#,0"
          },
          {
            "name": "Porcentaje de fallas",
            "expression": "DIVIDE([Fallas], [Observaciones], 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Torque promedio",
            "expression": "AVERAGE(fact_operacion[torque_nm])",
            "formatString": "0.00 \"Nm\""
          },
          {
            "name": "Desgaste promedio",
            "expression": "AVERAGE(fact_operacion[tool_wear_min])",
            "formatString": "0.00 \"min\""
          },
          {
            "name": "Temperatura promedio",
            "expression": "AVERAGE(fact_operacion[process_temperature_k])",
            "formatString": "0.00 \"K\""
          }
        ]
      },
