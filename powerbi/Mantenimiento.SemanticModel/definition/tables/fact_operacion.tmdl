table fact_operacion
	lineageTag: d5150ea7-f06d-42ed-9e3d-334015c08b7c

	measure Observaciones = COUNTROWS(fact_operacion)
		formatString: #,0
		lineageTag: 32c10817-ecb5-4a87-ba3d-6963d4d6aa9b

	measure Fallas = SUM(fact_operacion[estado_id])
		formatString: #,0
		lineageTag: 327eb7cd-5a3f-48fb-afa2-c666de22449e

	measure 'Porcentaje de fallas' = DIVIDE([Fallas], [Observaciones], 0)
		formatString: 0.00%
		lineageTag: e8325203-9426-40b0-8eb8-fd4873aadb37

	measure 'Torque promedio' = AVERAGE(fact_operacion[torque_nm])
		formatString: 0.00 "Nm"
		lineageTag: 595a7d5a-8c99-4545-b322-6a069d8ea951

	measure 'Desgaste promedio' = AVERAGE(fact_operacion[tool_wear_min])
		formatString: 0.00 "min"
		lineageTag: 7f3ab196-453a-4660-9a90-71b2bbe977be

	measure 'Temperatura promedio' = AVERAGE(fact_operacion[process_temperature_k])
		formatString: 0.00 "K"
		lineageTag: a2b3714e-c827-4a2b-a2b3-c1216dbd0a4d

